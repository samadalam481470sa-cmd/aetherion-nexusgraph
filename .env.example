# Copy to .env for local development. Never commit actual secrets.
NEXUSGRAPH_MODE=demo
NEXUSGRAPH_DB_PATH=/tmp/nexusgraph.sqlite3
# To enforce API-key authentication on registry endpoints:
# NEXUSGRAPH_MODE=protected
# NEXUSGRAPH_API_KEY=replace-with-long-random-secret-minimum-24-characters

# OIDC deployment mode (requires an identity provider issuing RS256 access tokens):
# NEXUSGRAPH_MODE=oidc
# NEXUSGRAPH_OIDC_ISSUER=https://issuer.example.com/
# NEXUSGRAPH_OIDC_AUDIENCE=nexusgraph-api
# NEXUSGRAPH_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# Optional protected aggregate Prometheus metrics:
# NEXUSGRAPH_METRICS_TOKEN=use-a-random-secret
